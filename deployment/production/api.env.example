API_ENV=production
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
LOG_LEVEL=INFO
AUTH_JWT_SECRET=REPLACE_WITH_UNIQUE_PRODUCTION_SECRET_MINIMUM_32_BYTES
AUTH_JWT_ISSUER=bonyan
AUTH_JWT_AUDIENCE=bonyan-api
AUTH_ACCESS_TOKEN_MINUTES=60
API_PUBLIC_URL=https://REPLACE_PRODUCTION_API_HOST
CORS_ALLOWED_ORIGINS=
PRIVATE_STORAGE_ROOT=/var/lib/bonyan/private
CHAT_MODEL=TBD
AVATAR_MODEL=TBD
MISTRAL_API_KEY=
MUSCLEWIKI_API_KEY=
