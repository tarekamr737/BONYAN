{
  "name": "bonyan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "install:all": "npm install && npm run api:install",
    "mobile:install": "npm install",
    "mobile:dev": "npm run dev --workspace @bonyan/mobile",
    "mobile:lint": "npm run lint --workspace @bonyan/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @bonyan/mobile",
    "mobile:test": "npm run test --workspace @bonyan/mobile",
    "mobile:export:web": "npm run export:web --workspace @bonyan/mobile",
    "api:install": "python -m pip install -e \"apps/api[dev]\"",
    "api:dev": "python -m uvicorn app.main:app --reload --app-dir apps/api",
    "api:lint": "python -m ruff check --config apps/api/pyproject.toml apps/api/app tests/api tests/community",
    "api:test": "python -m pytest -c apps/api/pyproject.toml",
    "api:migration": "python -m alembic -c apps/api/alembic.ini upgrade head",
    "lint": "npm run mobile:lint && npm run api:lint",
    "typecheck": "npm run mobile:typecheck",
    "test": "npm run mobile:test && npm run api:test"
  }
}
