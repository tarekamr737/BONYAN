API_ENV=staging
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
LOG_LEVEL=INFO
AUTH_JWT_SECRET=REPLACE_WITH_UNIQUE_STAGING_SECRET_MINIMUM_32_BYTES
AUTH_JWT_ISSUER=bonyan-staging
AUTH_JWT_AUDIENCE=bonyan-api-staging
AUTH_ACCESS_TOKEN_MINUTES=60
API_PUBLIC_URL=https://REPLACE_STAGING_API_HOST
FORWARDED_ALLOW_IPS=172.29.6.2
CORS_ALLOWED_ORIGINS=
PRIVATE_STORAGE_ROOT=/var/lib/bonyan/private
CHAT_PROVIDER=sovereigneg
CHAT_MODEL=glm-5.3-flash
CHAT_API_KEY=REPLACE_WITH_SOVEREIGNEG_STAGING_KEY
CHAT_TIMEOUT_SECONDS=20
EXERCISE_PROVIDER=exercisedb
EXERCISEDB_BASE_URL=https://oss.exercisedb.dev/api/v1
AVATAR_PROVIDER=cloudflare
AVATAR_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_STAGING_TOKEN
AVATAR_TIMEOUT_SECONDS=45
MISTRAL_API_KEY=
MUSCLEWIKI_API_KEY=
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_OCR_PER_MINUTE=10
RATE_LIMIT_COACH_PER_MINUTE=30
RATE_LIMIT_AVATAR_PER_MINUTE=6
RATE_LIMIT_MEDIA_TOKEN_PER_MINUTE=60
